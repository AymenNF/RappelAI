# LOCAL DEVELOPMENT ONLY. npm run setup creates random local secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://memorae:memorae_local_only@localhost:5432/memorae
# DATABASE_URL is migration/bootstrap-only. Populate runtime URLs with npm run db:provision:local.
INGRESS_DATABASE_URL=
WORKER_DATABASE_URL=
TENANT_DATABASE_URL=
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_VERIFY_TOKEN=replace-with-random-verification-token
# Optional allowlist; empty accepts all phone numbers belonging to this signed app.
WHATSAPP_PHONE_NUMBER_ID=
WORKER_POLL_INTERVAL_MS=30000
# disabled or fixture (fixed clarification plan, no network or AI inference).
MODEL_MODE=disabled
MODEL_TIMEOUT_MS=20000

# RESERVED for later milestones; not consumed by the current runtime.
REDIS_URL=redis://localhost:6379
WHATSAPP_ACCESS_TOKEN=
GRAPH_API_VERSION=
MODEL_API_KEY=
MODEL_FAST=
MODEL_SMART=
MODEL_EMBED=
MODEL_TRANSCRIBE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/v1/calendar/callback
ENCRYPTION_KEY_ID=
