{
  "name": "memorae",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WhatsApp personal assistant — foundation and system design",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "tsx watch src/api/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/api/main.js",
    "start:worker": "node dist/worker/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=2 tests/integration/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run eval:validate && npm run build && npm run format:check",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:provision:local": "tsx scripts/provision-local-db.ts",
    "infra:up": "node scripts/docker.mjs compose up -d --wait",
    "infra:down": "node scripts/docker.mjs compose down",
    "infra:status": "node scripts/docker.mjs compose ps",
    "onboarding:chat": "tsx scripts/onboarding-chat.ts",
    "smoke": "tsx scripts/local-smoke.ts",
    "work:retry": "tsx scripts/work-retry.ts",
    "usage:control": "tsx scripts/usage-control.ts",
    "delivery:control": "tsx scripts/delivery-control.ts",
    "eval:validate": "tsx evals/validate.ts",
    "eval:run": "tsx evals/run.ts",
    "eval": "tsx evals/score.ts",
    "quota:control": "tsx scripts/quota-control.ts",
    "privacy:control": "tsx scripts/privacy-control.ts",
    "ops:control": "tsx scripts/ops-control.ts",
    "staging:setup": "tsx scripts/staging-setup.ts",
    "staging:smoke": "tsx scripts/staging-smoke.ts",
    "staging:backup": "tsx scripts/staging-backup.ts",
    "restore:control": "tsx scripts/recovery-control.ts",
    "restore:drill": "tsx scripts/restore-drill.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "dotenv": "16.6.1",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
